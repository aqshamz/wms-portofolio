  status_id uuid [not null]
  billing_account_id uuid [not null]
  billing_contract_id varchar(120) [not null]
  currency_id uuid [not null]
  period_from date [not null]
  period_until date [not null]
  calculated_at timestamptz
  reviewed_at timestamptz
  reviewed_by uuid
  net_amount numeric(20,4) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null, note: 'default 0']
  notes text
  created_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
}

Table wms.billing_charge {
  billing_charge_id varchar(150) [pk, not null]
  billing_run_id varchar(120) [not null]
  billable_event_id varchar(140) [not null, unique]
  rate_card_line_id varchar(150) [not null]
  billed_quantity numeric(20,6) [not null]
  uom_id uuid
  unit_rate numeric(20,6) [not null]
  net_amount numeric(20,4) [not null]
  tax_rule_id uuid
  tax_rate_percent numeric(9,6) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null]
  currency_id uuid [not null]
  calculated_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
}

Table wms.billing_invoice {
  billing_invoice_id varchar(120) [pk, not null]
  document_type_id uuid [not null]
  status_id uuid [not null]
  billing_run_id varchar(120) [not null, unique]
  billing_account_id uuid [not null]
  billing_contract_id varchar(120) [not null]
  currency_id uuid [not null]
  invoice_date date [not null]
  due_date date [not null]
  bill_to_name varchar(200) [not null]
  bill_to_tax_number varchar(100)
  bill_to_address text [not null]
  net_amount numeric(20,4) [not null, note: 'default 0']
  adjustment_amount numeric(20,4) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null, note: 'default 0']
  credited_amount numeric(20,4) [not null, note: 'default 0']
  paid_amount numeric(20,4) [not null, note: 'default 0']
  balance_due numeric(20,4) [not null, note: 'default 0']
  issued_at timestamptz
  issued_by uuid
  notes text
  created_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
  updated_at timestamptz [not null, note: 'default clock_timestamp()']
  updated_by uuid [not null]
}

Table wms.billing_invoice_line {
  billing_invoice_line_id varchar(150) [pk, not null]
  billing_invoice_id varchar(120) [not null]
  line_no integer [not null]
  billing_charge_id varchar(150) [not null, unique]
  billing_service_id uuid [not null]
  description varchar(255) [not null]
  quantity numeric(20,6) [not null]
  uom_id uuid
  unit_rate numeric(20,6) [not null]
  net_amount numeric(20,4) [not null]
  tax_rule_id uuid
  tax_rate_percent numeric(9,6) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null]
  indexes {
    (billing_invoice_id, line_no) [unique]
  }
}

Table wms.billing_invoice_adjustment {
  invoice_adjustment_id varchar(150) [pk, not null]
  billing_invoice_id varchar(120) [not null]
  line_no integer [not null]
  billing_adjustment_type_id uuid [not null]
  reason_code_id uuid [not null]
  description varchar(255) [not null]
  amount numeric(20,4) [not null]
  tax_rule_id uuid
  tax_rate_percent numeric(9,6) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  created_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
  indexes {
    (billing_invoice_id, line_no) [unique]
  }
}

Table wms.billing_credit_note {
  credit_note_id varchar(120) [pk, not null]
  document_type_id uuid [not null]
  status_id uuid [not null]
  billing_invoice_id varchar(120) [not null]
  currency_id uuid [not null]
  credit_date date [not null]
  reason_code_id uuid [not null]
  net_amount numeric(20,4) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null, note: 'default 0']
  issued_at timestamptz
  issued_by uuid
  notes text
  created_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
}

Table wms.billing_credit_note_line {
  credit_note_line_id varchar(150) [pk, not null]
  credit_note_id varchar(120) [not null]
  billing_invoice_line_id varchar(150)
  line_no integer [not null]
  description varchar(255) [not null]
  net_amount numeric(20,4) [not null]
  tax_rate_percent numeric(9,6) [not null, note: 'default 0']
  tax_amount numeric(20,4) [not null, note: 'default 0']
  gross_amount numeric(20,4) [not null]
  indexes {
    (credit_note_id, line_no) [unique]
  }
}

Table wms.billing_payment {
  payment_id varchar(120) [pk, not null]
  document_type_id uuid [not null]
  status_id uuid [not null]
  billing_account_id uuid [not null]
  currency_id uuid [not null]
  payment_method_id uuid [not null]
  payment_date date [not null]
  amount numeric(20,4) [not null]
  unapplied_amount numeric(20,4) [not null]
  external_reference varchar(150)
  notes text
  created_at timestamptz [not null, note: 'default clock_timestamp()']
  created_by uuid [not null]
}

Table wms.billing_payment_allocation {
  payment_allocation_id varchar(150) [pk, not null]
  payment_id varchar(120) [not null]
  allocation_no integer [not null]
  billing_invoice_id varchar(120) [not null]
  allocated_amount numeric(20,4) [not null]
  allocated_at timestamptz [not null, note: 'default clock_timestamp()']
  allocated_by uuid [not null]
  indexes {
    (payment_id, billing_invoice_id) [unique]
    (payment_id, allocation_no) [unique]
  }
}

