  decimal_scale smallint [not null, note: 'default 2']
  is_active boolean [not null, note: 'default true']
}

Table wms.billing_cycle {
  billing_cycle_id uuid [pk, not null, note: 'default gen_random_uuid()']
  code varchar(40) [not null, unique]
  name varchar(100) [not null]
  period_days integer
  period_months integer
  is_on_demand boolean [not null, note: 'default false']
  is_active boolean [not null, note: 'default true']
}

Table wms.payment_term {
