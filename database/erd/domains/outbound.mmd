  outbound_check_exception_status ||--o{ outbound_check_exception : "status_id"
  outbound_check ||--o{ outbound_check_line : "outbound_check_id"
  outbound_check_result o|--o{ outbound_check_line : "outbound_check_result_id"
  outbound_staging_line ||--o{ outbound_check_line : "staging_line_id"
  outbound_check_resolution ||--o{ outbound_check_resolution_movement : "outbound_check_resolution_id"
  outbound_check_resolution ||--o{ outbound_check_resolution_reservation : "outbound_check_resolution_id"
  inventory_reservation ||--o{ outbound_check_resolution_reservation : "reservation_id"
  outbound_check_exception ||--o{ outbound_check_resolution : "outbound_check_exception_id"
  outbound_check_resolution_type ||--o{ outbound_check_resolution : "outbound_check_resolution_type_id"
  outbound_check o|--o{ outbound_check : "parent_check_id"
  outbound_staging ||--o{ outbound_check : "staging_id"
  outbound_order ||--o{ outbound_order_line : "outbound_id"
  pick_execution ||--o{ outbound_staging_line : "pick_execution_id"
  outbound_staging ||--o{ outbound_staging_line : "staging_id"
  outbound_order ||--o{ outbound_staging : "outbound_id"
  outbound_wave ||--o{ outbound_staging : "wave_id"
  outbound_validation_rule ||--o{ outbound_validation_result_detail : "outbound_validation_rule_id"
  outbound_validation_run ||--o{ outbound_validation_result_detail : "validation_run_id"
  validation_severity ||--o{ outbound_validation_rule : "validation_severity_id"
  outbound_order ||--o{ outbound_validation_run : "outbound_id"
  outbound_order ||--o{ outbound_wave_order : "outbound_id"
  outbound_wave ||--o{ outbound_wave_order : "wave_id"
  outbound_wave_type ||--o{ outbound_wave : "outbound_wave_type_id"
  outbound_check_line ||--o{ packing_line : "outbound_check_line_id"
  packing ||--o{ packing_line : "packing_id"
  pick_task ||--o{ packing_line : "pick_task_id"
  outbound_order ||--o{ packing : "outbound_id"
  pick_task ||--o{ pick_execution : "pick_task_id"
  outbound_order_line ||--o{ pick_task : "outbound_line_id"
  inventory_reservation ||--o{ pick_task : "reservation_id"
  outbound_wave ||--o{ pick_task : "wave_id"
  carrier_driver ||--o{ shipment_driver : "driver_id"
  shipment ||--o{ shipment_driver : "shipment_id"
