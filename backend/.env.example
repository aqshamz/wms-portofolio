APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TRUSTED_PROXIES=
APP_READ_HEADER_TIMEOUT_SECONDS=5
APP_READ_TIMEOUT_SECONDS=30
APP_WRITE_TIMEOUT_SECONDS=30
APP_IDLE_TIMEOUT_SECONDS=60
APP_SHUTDOWN_TIMEOUT_SECONDS=10

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SECURITY_RATE_LIMIT_PER_MINUTE=600
SECURITY_MAX_REQUEST_BODY_BYTES=1048576
AUTH_RBAC_ENFORCED=false

DB_HOST=localhost
DB_PORT=7654
DB_USER=postgres
DB_PASSWORD=change-me-before-use
DB_NAME=wms
DB_SCHEMA=wms
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_AUTO_CREATE=true

AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@wms.local
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=WMS Administrator
AUTH_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Before-Use-2026!
AUTH_BOOTSTRAP_ADMIN_TIMEZONE=Asia/Jakarta
